{
  "name": "zombie-eaters",
  "version": "1.0.0",
  "description": "Zombie Eaters: cartoon pixel-art survival arcade game for Aether",
  "main": "electron/main.cjs",
  "author": "Tvman",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tvman.zombieeaters",
    "productName": "Zombie Eaters",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "game.js",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
